{
  "name": "collabboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node scripts/free-ports.mjs && node server.js",
    "dev:all": "node scripts/free-ports.mjs --all && concurrently -n server,vite,inference -c blue,green,magenta \"npm run server\" \"npm run dev\" \"npm run dev:inference\"",
    "dev:inference": "node scripts/start-inference.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:load:ws": "node tests/load/run_ws_load.mjs",
    "test:api": "cd inference-api && ..\\.venv\\Scripts\\python.exe -m pytest tests/ -v --tb=short",
    "test:rules:suite": "vitest run --config vitest.rules.config.js",
    "test:rules": "npx firebase-tools emulators:exec --project demo-collabboard-rules --only firestore \"npm run test:rules:suite\"",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@hocuspocus/provider": "^4.0.0",
    "@hocuspocus/server": "^4.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "elkjs": "^0.11.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "firebase": "^12.13.0",
    "firebase-admin": "^13.10.0",
    "framer-motion": "^12.39.0",
    "html-to-image": "^1.11.13",
    "konva": "^10.3.0",
    "lucide-react": "^1.16.0",
    "node-cache": "^5.1.2",
    "onnxruntime-web": "^1.26.0",
    "openai": "^6.39.0",
    "p-retry": "^8.0.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-konva": "^19.2.4",
    "react-router-dom": "^7.15.1",
    "tiktoken": "^1.0.22",
    "uuid": "^14.0.0",
    "yjs": "^13.6.30",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^3.2.4",
    "concurrently": "^9.2.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "vite": "^8.0.12",
    "vitest": "^3.2.4"
  }
}
