# ── Frontend (Vite) ──
VITE_WS_URL=ws://localhost:1234
# FastAPI inference (primary AI pipeline)
VITE_INFERENCE_API_URL=http://localhost:8000
# Legacy Express AI (fallback)
# VITE_API_URL=http://localhost:3001
VITE_TELEMETRY_URL=
VITE_PROXY_TARGET=http://localhost:8000

# Firebase client (Vite)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── Legacy AI Backend (server.js on PORT 3001) ──
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=
PRIMARY_MODEL=gpt-4o
FALLBACK_MODEL=gemini-2.0-flash
MAX_TOKENS=2048
CONFIDENCE_THRESHOLD=0.75
PORT=3001
HOCUSPOCUS_PORT=1234
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── FastAPI Inference (port 8000) ──
ONNX_MODEL_PATH=ml/models/exported/diagram_detector_int8.onnx
CLASSES_PATH=ml/models/exported/classes.json
LLM_REFINEMENT_THRESHOLD=0.85
OTLP_ENDPOINT=
FIREBASE_SERVICE_ACCOUNT_JSON=

# ── ML Training ──
ROBOFLOW_API_KEY=

# ── Firebase Admin (optional — board persistence) ──
FIREBASE_SERVICE_ACCOUNT=
