# ── Frontend (Vite) ──
VITE_WS_URL=ws://localhost:1234
# FastAPI inference (primary AI pipeline)
VITE_INFERENCE_API_URL=http://localhost:8000
# Express AI Backend API (dual-signal routing, telemetry & admin stats)
VITE_API_URL=http://localhost:3001
VITE_TELEMETRY_URL=
VITE_PROXY_TARGET=http://localhost:3001

# Firebase Client Web Config (Vite)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── Express Server (server.js on PORT 3001) ──
PORT=3001
HOCUSPOCUS_PORT=1234
NODE_ENV=development

# Allowed CORS Origins (comma-separated; wildcards * forbidden in production)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Auth Bypass (DEVELOPMENT ONLY — server refuses to boot if true in production)
ALLOW_UNAUTHENTICATED=true

# AI Cloud Escalation & Fallback Keys
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=
PRIMARY_MODEL=gpt-4o
FALLBACK_MODEL=gemini-2.0-flash
MAX_TOKENS=2048

# Vision & NLP Routing Thresholds
CONFIDENCE_THRESHOLD=0.85
NLP_CONFIDENCE_THRESHOLD=0.88
MAX_PRUNE_RATIO=0.50

# Rate Limiting & Telemetry
AI_RATE_LIMIT_PER_HOUR=20
AI_RATE_LIMIT_IP_PER_HOUR=5
AI_REQUESTS_LOG_FILE=server/logs/ai_requests.ndjson

# Server-side URL for Express -> FastAPI calls (use http://inference:8000 in Docker)
INFERENCE_API_URL=http://localhost:8000

# Firebase Admin Service Account (for Firestore persistence & token verification)
FIREBASE_SERVICE_ACCOUNT=

# ── FastAPI Inference Microservice (port 8000) ──
ONNX_MODEL_PATH=ml/browser_models/collabboard_int8.onnx
CLASSES_PATH=public/models/classes.json
NLP_MODEL_PATH=ml/exports/nlp_model
LLM_REFINEMENT_THRESHOLD=0.85
OTLP_ENDPOINT=

# ── ML Training (Optional) ──
ROBOFLOW_API_KEY=
